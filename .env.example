# Template for the environment variables used by docker compose.
# Copy it to .env (cp .env.example .env) and change the values there.
# This file is committed, so it holds development-only values, never real secrets.
# The web container gets its own DATABASE_URL from docker-compose.yml; the one at the end is for Prisma.

# Name of the PostgreSQL user that the db service creates.
POSTGRES_USER=alumni

# Password for that user. "change_me" is only a placeholder: put your own secret password in .env.
POSTGRES_PASSWORD=change_me

# Name of the database that the db service creates.
POSTGRES_DB=alumni

# Connection string used by Prisma on your computer (host localhost);
# inside Docker, docker-compose.yml builds its own URL.
# Format: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB (keep it in sync with the values above).
DATABASE_URL="postgresql://alumni:change_me@localhost:5432/alumni"
