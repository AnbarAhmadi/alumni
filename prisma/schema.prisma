// Database tables for the Alumni Tracking System (PostgreSQL in Docker).
// The fields follow the design in ddd.md, which is the source of truth.
// The app does not use these tables yet: it still keeps users and announcements
// in memory (models/User.ts and models/Announcement.ts), whose fields differ
// (see "Differences between this design and the current code" in ddd.md).

// Prisma Client, generated into generated/prisma (git-ignored).
// Not imported anywhere in the app yet.
generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  // .mts files with .mts imports, so Node 24 can run the seed directly (no tsx needed)
  generatedFileExtension = "mts"
  importFileExtension    = "mts"
}

datasource db {
  provider = "postgresql"
}

// What a user may do on the site (ddd.md, Roles). Not the same as isAlumni,
// which says whether the person graduated.
enum Role {
  ADMIN
  ALUMNI
  STUDENT
}

model User {
  id             Int     @id @default(autoincrement())
  fullName       String
  email          String  @unique
  // Optional since Week 10: the register page doesn't ask for it.
  age            Int?
  school         String?
  isAlumni       Boolean @default(false)
  graduationYear Int?
  role           Role    @default(STUDENT)
  // A bcrypt hash, never the password. Never returned, logged or shown (ddd.md).
  passwordHash   String

  // Relations only (no columns in users): see job_postings and applications below.
  jobPostings  JobPosting[]
  applications Application[]
  sessions     Session[]

  @@map("users")
}

// One row per logged-in browser or client (ddd.md, Login and sessions). Only the SHA-256
// hash of the session token is stored, never the token. Deleting the user deletes their sessions.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Announcement {
  id       Int      @id @default(autoincrement())
  title    String
  message  String
  postedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("announcements")
}

// One user has many job postings; each posting belongs to exactly one user.
// Deleting the user deletes their postings (no orphan postings), see ddd.md.
model JobPosting {
  id           Int           @id @default(autoincrement())
  userId       Int
  title        String
  company      String
  city         String?
  description  String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("job_postings")
}

// Users and job postings are many-to-many through applications.
// A user can apply to a posting only once; deleting the user or the posting deletes the application.
model Application {
  id           Int        @id @default(autoincrement())
  userId       Int
  jobPostingId Int
  status       String     @default("applied")
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostingId])
  @@map("applications")
}
